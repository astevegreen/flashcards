{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "package_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "format_version": { "type": "number", "const": 1 },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "languages": { "default": [], "type": "array", "items": { "type": "string", "minLength": 1 } },
    "decks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "note_type_id": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "maxLength": 10000 },
          "preset_id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "folder_id": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "required": ["id", "name", "file", "note_type_id"],
        "additionalProperties": false
      }
    },
    "subset": { "type": "boolean" },
    "presets": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "settings": {
            "default": {},
            "type": "object",
            "properties": {
              "new_cards_per_day": { "type": "number" },
              "max_reviews_per_day": { "type": "number" },
              "target_retention": { "type": "number" }
            },
            "additionalProperties": false
          },
          "w": { "maxItems": 64, "type": "array", "items": { "type": "number" } }
        },
        "required": ["id", "name", "settings"],
        "additionalProperties": false
      }
    },
    "folders": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "required": ["id", "name"],
        "additionalProperties": false
      }
    }
  },
  "required": ["package_id", "name", "version", "format_version", "languages", "decks"],
  "additionalProperties": false
}
