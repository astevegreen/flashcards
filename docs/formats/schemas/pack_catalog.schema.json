{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format_version": { "type": "number", "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string" },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "dict-hanja-unihan",
              "dict-kanjidic2",
              "dict-cc-cedict",
              "dict-jmdict",
              "dict-krdict",
              "strokes-ja-kanjivg",
              "strokes-zh-mmah"
            ]
          },
          "kind": { "type": "string", "enum": ["dictionary", "strokes"] },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 1 },
          "script": { "type": "string", "enum": ["ja", "zh-Hans"] },
          "url": { "type": "string", "minLength": 1 },
          "compressed_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "uncompressed_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "entry_count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "license_name": { "type": "string", "minLength": 1 },
          "license_url": { "type": "string", "minLength": 1 },
          "attribution": { "type": "string", "minLength": 1 },
          "source_url": { "type": "string", "minLength": 1 },
          "optional": { "type": "boolean" },
          "char_url_template": { "type": "string", "minLength": 1 }
        },
        "required": [
          "id",
          "kind",
          "name",
          "description",
          "version",
          "language",
          "url",
          "compressed_bytes",
          "entry_count",
          "license_name",
          "license_url",
          "attribution",
          "source_url"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["format_version", "name", "packs"],
  "additionalProperties": false
}
