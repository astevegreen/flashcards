# Optional overrides for Google Drive Cloud Sync (Phase 2) & Google Picker Sources (Phase 3)
# All values are public client identifiers (GOOGLE_CLIENT_SECRET lives exclusively in apps/token-helper Cloudflare Worker secrets).
VITE_GOOGLE_CLIENT_ID=932735219487-p20rc5hu0gegb2bh43q8phe8lgi957v3.apps.googleusercontent.com
VITE_TOKEN_HELPER_URL=https://flashcards-token-helper.yodc.workers.dev
# Referrer-restricted Browser API Key (for Google Picker drive.file multi-select)
VITE_GOOGLE_API_KEY=

# Optional static catalog URLs (hosted via Cloudflare Pages / GitHub Pages / R2 with CORS headers)
# Unified offline dictionary & stroke pack manifest (packs.json — §6.3)
VITE_PACK_CATALOG_URL=
# Built-in Starter Decks catalog (FamilyCatalog index.json — §3.4)
VITE_STARTER_CATALOG_URL=

# Store / Direct-Sale Licensing (§12.1 — personal/family builds leave gate disabled by default)
VITE_ENABLE_LICENSE_GATE=false
VITE_LICENSE_PUBLIC_KEY=

# Optional Dropbox App Folder sync (public PKCE app key; no secret needed, no Worker)
VITE_DROPBOX_APP_KEY=
