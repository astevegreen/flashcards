{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flashcards",
  "version": "0.1.0",
  "identifier": "app.flashcards.localfirst",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm --filter @flash/web dev",
      "cwd": "../..",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "pnpm --filter @flash/web build",
      "cwd": "../.."
    },
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flashcards — Local-First Study",
        "width": 1160,
        "height": 800,
        "minWidth": 390,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; font-src 'self'; frame-src 'self' https://docs.google.com https://accounts.google.com; connect-src 'self' https: ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'; worker-src 'self';"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["flashcards"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Local-first foreign language flashcards"
  }
}
