{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "FORCE_COLOR": "0",
    "NO_COLOR": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm gate)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:e2e *)",
      "Bash(pnpm test:tools)",
      "Bash(pnpm build)",
      "Bash(pnpm size)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec prettier *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec playwright test *)",
      "Bash(pnpm --filter *)",
      "Bash(node scripts/*)",
      "Bash(node tools/*)",
      "Bash(node --test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git merge origin/main *)",
      "Bash(git worktree *)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr merge * --auto --squash)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "WebSearch",
      "WebFetch"
    ],
    "ask": [
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/tools/hooks/**)",
      "Edit(/.githooks/**)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git push *--no-verify*)",
      "Bash(git config core.hooksPath*)",
      "Bash(git -c core.hooksPath*)",
      "PowerShell(git commit *--no-verify*)",
      "PowerShell(git commit -n *)",
      "PowerShell(git commit * -n *)",
      "PowerShell(git push *--no-verify*)",
      "PowerShell(git config core.hooksPath*)",
      "PowerShell(git -c core.hooksPath*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/dist-packs/**)",
      "Read(**/.cache/**)",
      "Read(**/coverage/**)",
      "Read(**/*.log)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/packages/core/src/starters/generated/**)",
      "Bash(git stash)",
      "Bash(git stash *)",
      "Bash(git -C * stash*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push *+*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git -C * push *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git remote remove *)",
      "Bash(git remote rename *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "PowerShell(git stash*)",
      "PowerShell(git -C * stash*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f *)",
      "PowerShell(git push *+*)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push *:main*)",
      "PowerShell(git -C * push *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git rebase *)",
      "PowerShell(git filter-branch *)",
      "PowerShell(git filter-repo *)",
      "PowerShell(git remote add *)",
      "PowerShell(git remote set-url *)",
      "PowerShell(git remote remove *)",
      "PowerShell(git remote rename *)",
      "PowerShell(gh repo edit *)",
      "PowerShell(gh repo delete *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/env-check.mjs"],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/quick-check.mjs"],
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/gate.mjs"],
            "timeout": 600
          }
        ]
      }
    ]
  }
}
