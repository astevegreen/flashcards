{
  "name": "@flash/platform-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./onedrive": {
      "types": "./src/onedrive-services.ts",
      "default": "./src/onedrive-services.ts"
    },
    "./dropbox": {
      "types": "./src/dropbox-services.ts",
      "default": "./src/dropbox-services.ts"
    },
    "./pkce": {
      "types": "./src/auth/pkce.ts",
      "default": "./src/auth/pkce.ts"
    },
    "./purchase-license": {
      "types": "./src/purchase/web-license-purchase.ts",
      "default": "./src/purchase/web-license-purchase.ts"
    },
    "./native-support": {
      "types": "./src/native-support.ts",
      "default": "./src/native-support.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@flash/core": "workspace:*",
    "@flash/platform": "workspace:*",
    "dexie": "^4.4.7",
    "fsrs-browser": "6.6.0",
    "fzstd": "^0.1.1",
    "read-excel-file": "^9.3.20",
    "sql.js": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.8",
    "vitest": "^5.1.1"
  }
}
