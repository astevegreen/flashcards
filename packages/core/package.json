{
  "name": "@flash/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./flashpkg": {
      "types": "./src/import/flashpkg.ts",
      "default": "./src/import/flashpkg.ts"
    },
    "./csv": {
      "types": "./src/import/csv.ts",
      "default": "./src/import/csv.ts"
    },
    "./sync": {
      "types": "./src/sync/index.ts",
      "default": "./src/sync/index.ts"
    },
    "./sources": {
      "types": "./src/sources/index.ts",
      "default": "./src/sources/index.ts"
    },
    "./duplicates": {
      "types": "./src/tags/duplicates.ts",
      "default": "./src/tags/duplicates.ts"
    },
    "./find-replace": {
      "types": "./src/tags/find-replace.ts",
      "default": "./src/tags/find-replace.ts"
    },
    "./answer-match": {
      "types": "./src/study/answer-match.ts",
      "default": "./src/study/answer-match.ts"
    },
    "./choice": {
      "types": "./src/study/choice.ts",
      "default": "./src/study/choice.ts"
    },
    "./audio": {
      "types": "./src/audio/tts.ts",
