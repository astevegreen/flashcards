    "./drawing": {
      "types": "./src/drawing/index.ts",
      "default": "./src/drawing/index.ts"
    },
    "./dictionary": {
      "types": "./src/dictionary/index.ts",
      "default": "./src/dictionary/index.ts"
    },
    "./samples": {
      "types": "./src/samples/decks.ts",
      "default": "./src/samples/decks.ts"
    },
    "./starters": {
      "types": "./src/starters/index.ts",
      "default": "./src/starters/index.ts"
    },
    "./starter-upgrade": {
      "types": "./src/starters/upgrade.ts",
      "default": "./src/starters/upgrade.ts"
    },
    "./snapshot": {
      "types": "./src/events/snapshot.ts",
      "default": "./src/events/snapshot.ts"
    },
    "./backup": {
      "types": "./src/backup/index.ts",
      "default": "./src/backup/index.ts"
    },
    "./check": {
      "types": "./src/check/index.ts",
      "default": "./src/check/index.ts"
    },
    "./license": {
      "types": "./src/license/index.ts",
      "default": "./src/license/index.ts"
    },
    "./stats": {
      "types": "./src/stats/index.ts",
      "default": "./src/stats/index.ts"
    },
    "./fsrs-optimizer": {
      "types": "./src/optimizer/fsrs-optimizer.ts",
      "default": "./src/optimizer/fsrs-optimizer.ts"
    },
    "./anki-limits": {
      "types": "./src/import/anki/limits.ts",
      "default": "./src/import/anki/limits.ts"
    },
    "./pack-limits": {
      "types": "./src/dictionary/limits.ts",
      "default": "./src/dictionary/limits.ts"
    },
    "./anki": {
      "types": "./src/import/anki/index.ts",
      "default": "./src/import/anki/index.ts"
    },
    "./anki-export": {
      "types": "./src/export/anki/index.ts",
      "default": "./src/export/anki/index.ts"
    },
    "./import-detect": {
