{
  "name": "@flash/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./flashpkg": {
      "types": "./src/import/flashpkg.ts",
      "default": "./src/import/flashpkg.ts"
    },
    "./csv": {
      "types": "./src/import/csv.ts",
      "default": "./src/import/csv.ts"
    },
    "./sync": {
      "types": "./src/sync/index.ts",
      "default": "./src/sync/index.ts"
    },
    "./sources": {
      "types": "./src/sources/index.ts",
      "default": "./src/sources/index.ts"
    },
    "./answer-match": {
      "types": "./src/study/answer-match.ts",
      "default": "./src/study/answer-match.ts"
    },
    "./choice": {
      "types": "./src/study/choice.ts",
      "default": "./src/study/choice.ts"
    },
    "./audio": {
      "types": "./src/audio/tts.ts",
      "default": "./src/audio/tts.ts"
    },
    "./drawing": {
      "types": "./src/drawing/index.ts",
      "default": "./src/drawing/index.ts"
    },
    "./dictionary": {
      "types": "./src/dictionary/index.ts",
      "default": "./src/dictionary/index.ts"
    },
    "./samples": {
      "types": "./src/samples/decks.ts",
      "default": "./src/samples/decks.ts"
    },
    "./starters": {
      "types": "./src/starters/index.ts",
      "default": "./src/starters/index.ts"
    },
    "./snapshot": {
      "types": "./src/events/snapshot.ts",
      "default": "./src/events/snapshot.ts"
    },
    "./license": {
      "types": "./src/license/index.ts",
      "default": "./src/license/index.ts"
    },
    "./stats": {
      "types": "./src/stats/index.ts",
      "default": "./src/stats/index.ts"
    },
    "./fsrs-optimizer": {
      "types": "./src/optimizer/fsrs-optimizer.ts",
      "default": "./src/optimizer/fsrs-optimizer.ts"
    },
    "./anki": {
      "types": "./src/import/anki/index.ts",
      "default": "./src/import/anki/index.ts"
    },
    "./import-detect": {
      "types": "./src/import/detect.ts",
      "default": "./src/import/detect.ts"
    },
    "./import-mapping": {
      "types": "./src/import/column-mapping.ts",
      "default": "./src/import/column-mapping.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@flash/content-schema": "workspace:*",
    "fflate": "^0.8.3",
    "ts-fsrs": "^6.0.0",
    "wanakana": "^5.3.1"
  }
}
