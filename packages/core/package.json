{
  "name": "@flash/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./flashpkg": {
      "types": "./src/import/flashpkg.ts",
      "default": "./src/import/flashpkg.ts"
    },
    "./csv": {
      "types": "./src/import/csv.ts",
      "default": "./src/import/csv.ts"
    },
    "./sync": {
      "types": "./src/sync/index.ts",
      "default": "./src/sync/index.ts"
    },
    "./sources": {
      "types": "./src/sources/index.ts",
      "default": "./src/sources/index.ts"
    },
    "./answer-match": {
      "types": "./src/study/answer-match.ts",
      "default": "./src/study/answer-match.ts"
    },
    "./audio": {
      "types": "./src/audio/tts.ts",
      "default": "./src/audio/tts.ts"
    },
    "./samples": {
      "types": "./src/samples/decks.ts",
      "default": "./src/samples/decks.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@flash/content-schema": "workspace:*",
    "fflate": "^0.8.3",
    "ts-fsrs": "^6.0.0",
    "wanakana": "^5.3.1"
  }
}
