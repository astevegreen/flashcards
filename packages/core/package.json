  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@flash/content-schema": "workspace:*",
    "fflate": "^0.8.3",
    "ts-fsrs": "^6.0.0",
    "wanakana": "^5.3.1"
