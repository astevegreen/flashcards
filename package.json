{
  "name": "flashcards-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.2.0",
    "pnpm": ">=12.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter @flash/web dev",
    "build": "pnpm -r --filter \"!@flash/desktop\" build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "packs:check": "node scripts/build-packs.mjs --starter --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest run --config vitest.bench.config.ts",
    "test:e2e": "playwright test",
    "test:tools": "node --test \"tools/hooks/*.test.mjs\" \"tools/gemini/*.test.mjs\" \"tools/*.test.mjs\"",
    "size": "size-limit && node scripts/check-no-fonts.mjs",
    "gate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm packs:check && pnpm test && pnpm test:tools",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.3",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "size-limit": "^14.3.0",
    "sql.js": "^1.17.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
